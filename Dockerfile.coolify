# Build this deployment's ready-to-run image on GitHub, not on the shared VPS.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# This deployment always uses local_noauth behind its existing Traefik Basic
# Auth middleware. These non-secret values are the only client build inputs.
RUN AUTH_MODE=local_noauth VITE_SHOW_DEVTOOLS=false NODE_OPTIONS=--max-old-space-size=4096 pnpm run build

EXPOSE 3001

CMD ["sh", "-c", "pnpm run db:migrate:local && exec pnpm exec vite preview --host 0.0.0.0 --port ${PORT:-3001}"]
