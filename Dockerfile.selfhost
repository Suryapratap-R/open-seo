# Use the full Node image so workerd has a working CA trust store for outbound HTTPS.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

RUN AUTH_MODE=local_noauth VITE_SHOW_DEVTOOLS=false NODE_OPTIONS=--max-old-space-size=4096 pnpm run build

EXPOSE 3001

# This deployment's Compose contract is always local_noauth behind external
# Traefik authentication, so the client bundle can be built before Coolify
# replaces the running container. Runtime startup only applies local migrations
# and starts the already-built preview server.
CMD ["sh", "-c", "pnpm run db:migrate:local && exec pnpm exec vite preview --host 0.0.0.0 --port ${PORT:-3001}"]
